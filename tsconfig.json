{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "baseUrl": "."
  },
  "include": ["website/**/*.ts", "website/**/*.tsx", "website/**/*.astro"],
  "exclude": ["node_modules", "dist", "website/dist"]
}
