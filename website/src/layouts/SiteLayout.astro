---
import '../styles/global.css';
const { title = 'HTE Universe — Music. Beats. Production. Beyond.', description = 'Discover music, artists, videos and creative services from HTE Universe, the official digital entertainment platform of High-Tech Entertainment.' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#090909" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HTE Universe" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href="https://suwilanjisinkamba184-cmd.github.io/High-tech-entertainment-/" />
    <meta property="og:url" content="https://suwilanjisinkamba184-cmd.github.io/High-tech-entertainment-/" />
    <meta property="og:image" content="https://images.unsplash.com/photo-1511379938547-c1f69419868d?auto=format&fit=crop&w=1600&q=85" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${base}high-tech-logo.svg`} />
    <link rel="preconnect" href="https://wqrxacjbsldbnoekbkbf.supabase.co" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.119.0"></script>
    <script is:inline src={`${base}supabase-config.js`}></script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
