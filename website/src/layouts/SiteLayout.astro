---
import '../styles/global.css';
const { title = 'HTE Universe — Music. Beats. Production. Beyond.', description = 'Discover music, artists, videos and creative services from HTE Universe, the official digital entertainment platform of High-Tech Entertainment.', canonical = 'https://suwilanjisinkamba184-cmd.github.io/High-tech-entertainment-/', image = 'https://images.unsplash.com/photo-1511379938547-c1f69419868d?fit=crop&w=1200&h=630&q=85&fm=jpg', needsSupabase = false, loadFonts = false, imageAlt = 'High-Tech Entertainment — HTE Universe cinematic gold and black entertainment artwork' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#090909" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_ZM" />
    <meta property="og:site_name" content="HTE Universe" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="author" content="High-Tech Entertainment" />
    <link rel="icon" type="image/svg+xml" href={`${base}high-tech-logo.svg`} />
    {loadFonts && <>
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap" rel="stylesheet" />
    </>}
    {needsSupabase && <>
      <link rel="preconnect" href="https://wqrxacjbsldbnoekbkbf.supabase.co" />
      <link rel="preconnect" href="https://images.unsplash.com" />
      <script is:inline defer src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.119.0"></script>
      <script is:inline defer src={`${base}supabase-config.js`}></script>
    </>}
    <link rel="stylesheet" href={`${base}assets/emil-interaction-polish.css?v=1`} />
    <link rel="stylesheet" href={`${base}assets/hte-universe-2026.css?v=1`} />
    <link rel="stylesheet" href={`${base}assets/hte-player.css?v=20261125-1`} />
    <link rel="stylesheet" href={`${base}assets/hte-universe-full-ui.css?v=20261125-1`} />
    <link rel="stylesheet" href={`${base}assets/catalogue-experience.css?v=2`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline defer src={`${base}assets/catalogue-experience.js?v=2`}></script>
    <script is:inline defer src={`${base}assets/hte-player.js?v=20261125-1`}></script>
  </body>
</html>
