  <script is:inline define:vars={{base}}>
    const authNext = new URLSearchParams(window.location.search).get('next');
    if (authNext === 'account' || authNext === 'admin') {
      const destination = new URL(base + authNext + '/', window.location.origin);
      const callbackParams = new URLSearchParams(window.location.search);
      callbackParams.delete('next');
      callbackParams.forEach((value, key) => destination.searchParams.append(key, value));
      destination.hash = window.location.hash;
      window.location.replace(destination.href);
    }
