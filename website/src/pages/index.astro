---
import SiteLayout from '../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const organizationSchema = {"@context":"https://schema.org","@graph":[{"@type":"Organization","name":"High-Tech Entertainment","alternateName":["HTE Universe","Hi-Tech Studio"],"logo":"https://suwilanjisinkamba184-cmd.github.io/High-tech-entertainment-/high-tech-logo.svg","founder":{"@type":"Person","name":"L Junior ZM","alternateName":"L Junior Zambia"},"address":{"@type":"PostalAddress","addressLocality":"Kitwe","addressCountry":"ZM"},"url":"https://suwilanjisinkamba184-cmd.github.io/High-tech-entertainment-/","description":"Music production, recording, beat production, artist development, Spotify promotion and software development from High-Tech Entertainment in Kitwe, Zambia.","sameAs":["https://open.spotify.com/artist/15MbaDwHuXAtvQCyscJA0H"]},{"@type":"WebSite","name":"HTE Universe","url":"https://suwilanjisinkamba184-cmd.github.io/High-tech-entertainment-/"}]};
const faqSchema = {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I book a session?","acceptedAnswer":{"@type":"Answer","text":"Fill in the booking form or message us on WhatsApp. Your date is confirmed only after we reply."}},{"@type":"Question","name":"Which genres do you work in?","acceptedAnswer":{"@type":"Answer","text":"Afrobeat, Dancehall, Drill and Choir, and we are open to other styles."}},{"@type":"Question","name":"Where are you based?","acceptedAnswer":{"@type":"Answer","text":"Kitwe, Zambia, working with artists locally and worldwide."}}]};
---
<SiteLayout title="HTE Universe | Music. Creativity. Connection." description="Discover music, artists, videos and creative services from HTE Universe, the official digital entertainment platform of High-Tech Entertainment.">
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <style is:global>

:root{--bg:#090909;--bg2:#111111;--panel:rgba(255,255,255,.04);--line:rgba(197,164,90,.16);--text:#FFFFFF;--muted:#A6A6A6;--c1:#C5A45A;--c2:#BFC3C7;--grad:linear-gradient(120deg,#C5A45A,#BFC3C7);--r:18px;--head:"Montserrat",system-ui,sans-serif;--body:Inter,system-ui,sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--bg);color:var(--text);font:400 16px/1.65 var(--body);-webkit-font-smoothing:antialiased;overflow-x:hidden;background-image:linear-gradient(rgba(197,164,90,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(197,164,90,.045) 1px,transparent 1px);background-size:56px 56px}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(60% 40% at 80% 0,rgba(191,195,199,.18),transparent 70%),radial-gradient(50% 40% at 0 30%,rgba(197,164,90,.12),transparent 70%);z-index:-1}
img{max-width:100%;display:block}a{color:inherit;text-decoration:none}
.wrap{width:min(1180px,100% - 40px);margin-inline:auto}
.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;background:#fff;color:#000;padding:8px 12px;z-index:99;border-radius:8px}
:focus-visible{outline:2px solid var(--c1);outline-offset:3px}
h1,h2,h3{font-family:var(--head);line-height:1.08;margin:0;letter-spacing:-.02em}
h1{font-size:clamp(2.6rem,7vw,5.2rem)}h2{font-size:clamp(1.9rem,4vw,3rem)}h3{font-size:1.2rem}
.grad,.gold-text{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.eyebrow{font:600 .75rem var(--head);letter-spacing:.18em;text-transform:uppercase;color:var(--c1);margin-bottom:14px;display:flex;align-items:center;gap:10px}
.eyebrow:before{content:"";width:28px;height:1px;background:var(--grad)}
.muted,.lead,p{color:var(--muted)}.lead{font-size:1.15rem;max-width:52ch;margin:22px 0 0}
/* header */
.topbar{position:sticky;top:0;z-index:50;backdrop-filter:blur(16px);background:rgba(5,6,10,.72);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top,0)}
.nav{display:flex;align-items:center;gap:20px;height:68px}
.brand{display:flex;align-items:center;gap:10px;font:700 1.1rem var(--head)}.brand-logo{height:34px;width:auto}
.brand-wordmark small{display:none;font:500 .6rem var(--body);letter-spacing:.16em;color:var(--muted)}
.navlinks{display:flex;gap:4px;margin-left:auto}.navlinks a{padding:8px 13px;border-radius:99px;color:var(--muted);font-size:.92rem;transition:.2s}.navlinks a:hover{color:#fff;background:var(--panel)}
.menu-toggle{display:none;background:none;border:1px solid var(--line);border-radius:12px;width:44px;height:44px;padding:0;margin-left:auto;flex-direction:column;justify-content:center;align-items:center;gap:5px;cursor:pointer}
.menu-toggle span{width:20px;height:2px;background:#fff;border-radius:2px}
/* buttons */
.btn{display:inline-flex;align-items:center;gap:8px;padding:13px 24px;border-radius:99px;border:1px solid var(--line);background:var(--panel);color:var(--text);font:600 .95rem var(--body);cursor:pointer;transition:.25s}
.btn:hover{border-color:var(--c1);transform:translateY(-2px)}
.btn.gold{background:var(--grad);border-color:transparent;color:#090909;box-shadow:0 8px 30px rgba(197,164,90,.25)}.btn.gold:hover{box-shadow:0 10px 40px rgba(191,195,199,.45)}
.btn.ghost{background:transparent}
/* hero */
.hero{padding:clamp(48px,9vw,110px) 0 70px}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}
.hero-art{position:relative;border-radius:28px;overflow:hidden;border:1px solid var(--line);aspect-ratio:4/5;box-shadow:0 0 80px rgba(191,195,199,.25)}
.hero-photo{width:100%;height:100%;object-fit:cover;filter:saturate(.8) contrast(1.05)}
.hero-photo-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(5,6,10,.1),rgba(5,6,10,.88)),linear-gradient(135deg,rgba(197,164,90,.18),rgba(191,195,199,.25))}
.hero-stamp{position:absolute;left:20px;right:20px;bottom:20px;padding:18px;border-radius:14px;border:1px solid var(--line);backdrop-filter:blur(14px);background:rgba(5,6,10,.55)}
.hero-stamp span,.hero-stamp small{display:block;font:600 .68rem var(--head);letter-spacing:.14em;color:var(--c1)}.hero-stamp strong{display:block;font:700 1.15rem var(--head);margin:6px 0;color:#fff}.hero-stamp small{color:var(--muted)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;margin-top:60px}
.stats div{background:var(--bg2);padding:22px;text-align:center}.stats b{display:block;font:700 1.6rem var(--head);background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}.stats span{font-size:.8rem;color:var(--muted)}
/* sections */
.section{padding:clamp(56px,8vw,100px) 0}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:40px;flex-wrap:wrap}.section-head p{max-width:56ch;margin:12px 0 0}
.experience-grid,.journal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.experience-card{position:relative;border-radius:var(--r);overflow:hidden;min-height:380px;border:1px solid var(--line);display:flex;align-items:end;transition:.3s}
.experience-card:hover{transform:translateY(-6px);border-color:var(--c1)}
.experience-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:.6s}.experience-card:hover img{transform:scale(1.06)}
.experience-overlay{position:absolute;inset:0;background:linear-gradient(180deg,transparent 20%,rgba(5,6,10,.95))}
.experience-copy{position:relative;padding:24px}.experience-copy small{color:var(--c1);font:600 .72rem var(--head);letter-spacing:.16em}.experience-copy strong{display:block;font:700 1.6rem/1.15 var(--head);margin:8px 0}.experience-copy em{font-style:normal;color:var(--muted);font-size:.88rem}
.journal-grid{grid-template-columns:1.2fr 1fr}.journal-feature{position:relative;border-radius:var(--r);overflow:hidden;border:1px solid var(--line);min-height:460px;display:flex;align-items:end}
.journal-feature img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55}.journal-feature-copy{position:relative;padding:28px;background:linear-gradient(transparent,var(--bg))}
.journal-stack{display:grid;gap:18px}.journal-story{display:grid;grid-template-columns:140px 1fr;gap:16px;padding:14px;border:1px solid var(--line);border-radius:var(--r);background:var(--panel)}
.journal-story img{height:100%;min-height:140px;object-fit:cover;border-radius:12px}.journal-story p{margin:6px 0;font-size:.9rem}
.journal-kicker{font:600 .68rem var(--head);letter-spacing:.14em;color:var(--c1)}.journal-feature h3{font-size:1.7rem;margin:8px 0}
.journal-feature a,.journal-story a,.video-open-youtube{color:var(--c1);font-weight:600;font-size:.9rem}.journal-mark{font:600 .75rem var(--head);letter-spacing:.2em;color:var(--muted)}
/* dynamic cards (works with content injected by app.js) */
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px}
.cards>*,.video-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:16px;transition:.25s;overflow:hidden}
.cards>*:hover{border-color:var(--c1);transform:translateY(-4px)}
.cards img{border-radius:12px;width:100%;aspect-ratio:1;object-fit:cover;margin-bottom:12px}.cards audio{width:100%;margin-top:10px}.cards iframe,.video-embed{width:100%;aspect-ratio:16/9;border:0;border-radius:12px;margin-bottom:12px}
.video-card-kicker{display:block;font:600 .68rem var(--head);letter-spacing:.14em;color:var(--c2);margin-bottom:10px;text-transform:uppercase}.video-card h3{margin-bottom:2px}.video-card p{margin:0 0 10px}
.empty{color:var(--muted);padding:30px;text-align:center;border:1px dashed var(--line);border-radius:var(--r);grid-column:1/-1}.video-source-note{font-size:.8rem;margin-top:20px}
/* about / services */
.feature-band{display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center;padding:clamp(28px,5vw,56px);border-radius:28px;border:1px solid var(--line);background:linear-gradient(135deg,rgba(197,164,90,.08),rgba(191,195,199,.12))}
.genre-note,.vocal-project-note{font:600 .8rem var(--head);letter-spacing:.14em;color:var(--c1)}.vocal-project-note span{color:var(--muted);margin-right:8px}
.team-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;margin-top:18px}.team-card{padding:22px;border:1px solid var(--line);border-radius:var(--r);background:var(--panel)}.team-card span{font:600 .7rem var(--head);letter-spacing:.16em;color:var(--c1)}.team-card h3{margin:6px 0}.team-card p{margin:0}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start}.contact-copy h2{margin-bottom:16px}
.service-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:28px}.service-card{padding:16px;border:1px solid var(--line);border-radius:14px;background:var(--panel);transition:.25s}.service-card:hover{border-color:var(--c2)}.service-card h3{font-size:1rem;margin-bottom:4px}.service-card p{margin:0;font-size:.85rem}
/* forms */
.panel{padding:clamp(22px,3vw,34px);border-radius:24px;border:1px solid var(--line);background:linear-gradient(160deg,rgba(255,255,255,.06),rgba(255,255,255,.02));backdrop-filter:blur(10px)}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field.full{grid-column:1/-1}.field label{display:block;font-size:.82rem;font-weight:600;margin-bottom:6px}
input,select,textarea{width:100%;padding:13px 14px;border-radius:12px;border:1px solid var(--line);background:rgba(5,6,10,.7);color:var(--text);font:inherit;font-size:16px}
textarea{min-height:130px;resize:vertical}input:focus,select:focus,textarea:focus{outline:none;border-color:var(--c1);box-shadow:0 0 0 3px rgba(197,164,90,.18)}
.status{margin-top:12px;font-size:.9rem;min-height:1.2em}.small{font-size:.8rem}
.footer{border-top:1px solid var(--line);padding:30px 0 calc(30px + env(safe-area-inset-bottom,0));color:var(--muted);font-size:.88rem}.footer-row{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}.footer a:hover{color:var(--c1)}
.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,30px);opacity:0;pointer-events:none;background:var(--bg2);border:1px solid var(--c1);padding:12px 20px;border-radius:12px;transition:.3s;z-index:90}.toast.show,.toast.is-visible{opacity:1;transform:translate(-50%,0)}
.hte-honeypot{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important}
.js .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s,transform .7s}.js .reveal.in{opacity:1;transform:none}
@media(max-width:900px){.hero-grid,.contact-grid,.journal-grid,.experience-grid,.feature-band{grid-template-columns:1fr}.hero-art{aspect-ratio:16/11}.stats{grid-template-columns:1fr 1fr}.menu-toggle{display:flex}.nav-actions{display:none}
.navlinks{position:absolute;top:68px;left:0;right:0;flex-direction:column;padding:14px 20px 20px;background:rgba(5,6,10,.97);border-bottom:1px solid var(--line);display:none;margin:0}.navlinks.open{display:flex}.navlinks a{padding:14px;font-size:1rem}}
@media(max-width:560px){.form-grid,.service-grid{grid-template-columns:1fr}.journal-story{grid-template-columns:100px 1fr}.hero-actions .btn{flex:1 1 100%;justify-content:center}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}.reveal{opacity:1;transform:none}}

.eq{display:flex;gap:4px;align-items:flex-end;height:34px;margin-top:30px}.eq i{width:4px;border-radius:3px;background:var(--grad);animation:eq 1.1s ease-in-out infinite;height:30%}
.eq i:nth-child(2n){animation-delay:-.4s}.eq i:nth-child(3n){animation-delay:-.7s}.eq i:nth-child(5n){animation-delay:-.2s}
@keyframes eq{0%,100%{height:20%}50%{height:100%}}
.hero-art:after{content:"";position:absolute;left:0;right:0;height:2px;background:var(--c1);box-shadow:0 0 18px var(--c1);animation:scan 5s linear infinite;opacity:.5}
@keyframes scan{from{top:0}to{top:100%}}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;counter-reset:s}.step{position:relative;padding:26px 22px;border:1px solid var(--line);border-radius:var(--r);background:var(--panel)}
.step:before{counter-increment:s;content:"0" counter(s);font:700 2.2rem var(--head);background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;display:block;margin-bottom:8px}.step h3{margin-bottom:6px}.step p{margin:0;font-size:.92rem}
.faq{display:grid;gap:12px;max-width:820px}.faq details{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:0 20px}.faq summary{cursor:pointer;padding:18px 0;font:600 1.02rem var(--head);list-style:none;display:flex;justify-content:space-between;gap:12px}
.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:"+";color:var(--c1);font-size:1.4rem;line-height:1}.faq details[open] summary:after{content:"–"}.faq details p{margin:0 0 18px}
.faq details[open]{border-color:var(--c1)}
.marquee{overflow:hidden;border-block:1px solid var(--line);padding:14px 0;background:rgba(255,255,255,.02)}.marquee div{display:flex;gap:48px;width:max-content;animation:mq 28s linear infinite;font:600 .8rem var(--head);letter-spacing:.2em;color:var(--muted)}.marquee span:nth-child(3n){color:var(--c1)}
@keyframes mq{to{transform:translateX(-50%)}}
.progress{position:fixed;top:0;left:0;height:3px;width:0;background:var(--grad);z-index:100}
.loc{display:grid;gap:10px;margin-top:22px;padding:18px;border:1px solid var(--line);border-radius:14px;background:var(--panel);font-size:.92rem}.loc b{color:#fff}
@media(max-width:900px){.steps{grid-template-columns:1fr 1fr}}@media(max-width:560px){.steps{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.eq i,.hero-art:after,.marquee div{animation:none}}
.yt{position:relative;display:block;width:100%;aspect-ratio:16/9;border:0;border-radius:12px;margin-bottom:12px;padding:0;cursor:pointer;background:#000 center/cover no-repeat;overflow:hidden}
.yt:before{content:"";position:absolute;inset:0;background:linear-gradient(transparent 40%,rgba(5,6,10,.75))}
.yt span{position:absolute;left:50%;top:50%;width:64px;height:64px;margin:-32px;border-radius:50%;background:var(--grad);display:grid;place-items:center;box-shadow:0 0 30px rgba(197,164,90,.5);transition:.25s}
.yt:hover span{transform:scale(1.1)}.yt span:after{content:"";border-left:18px solid #090909;border-block:11px solid transparent;margin-left:5px}
.navlinks a.active{color:#fff;background:var(--panel)}.navlinks .mob-only{display:none}
@media(max-width:900px){.navlinks .mob-only{display:block}}

/* ===== v4 UI upgrade ===== */
.aurora{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}.aurora i{position:absolute;width:55vmax;height:55vmax;border-radius:50%;filter:blur(90px);opacity:.28;animation:drift 22s ease-in-out infinite alternate}
.aurora i:first-child{background:#C5A45A;top:-25vmax;left:-15vmax}.aurora i:last-child{background:#BFC3C7;right:-20vmax;top:25vh;animation-delay:-9s}
@keyframes drift{to{transform:translate(8vmax,6vmax) scale(1.15)}}
.topbar{top:10px;margin:10px auto 0;width:min(1240px,calc(100% - 20px));border:1px solid var(--line);border-radius:22px;padding-top:0;background:rgba(10,13,22,.62);box-shadow:0 10px 40px rgba(0,0,0,.35)}
.topbar .wrap{width:100%;padding:0 14px}.nav{gap:14px}
.brand{flex:0 0 auto;gap:12px}.brand-logo{height:40px;min-width:40px;width:auto;padding:4px;border-radius:12px;background:rgba(255,255,255,.07);border:1px solid var(--line)}
.brand-wordmark{display:flex;flex-direction:column;line-height:1.1;white-space:nowrap}.brand-wordmark b{font:700 1.25rem var(--head);letter-spacing:.04em;color:#fff}
.brand-wordmark small{display:block!important;font:600 .62rem var(--body);letter-spacing:.2em;color:var(--c1);margin-top:2px}
.navlinks{gap:2px}.navlinks a{white-space:nowrap;padding:8px 11px;font-size:.88rem}
.nav-actions .btn{padding:10px 18px;white-space:nowrap}
@media(max-width:1100px){.menu-toggle{display:flex}.nav-actions{display:none}.navlinks .mob-only{display:block}
.navlinks{position:absolute;top:calc(100% + 8px);left:0;right:0;flex-direction:column;padding:14px;background:rgba(8,10,18,.97);border:1px solid var(--line);border-radius:18px;display:none;margin:0}.navlinks.open{display:flex}.navlinks a{padding:14px;font-size:1rem}}
@media(max-width:380px){.brand-wordmark small{letter-spacing:.1em;font-size:.55rem}}
.hero{padding-top:clamp(36px,7vw,84px)}h1{font-size:clamp(2.8rem,8.5vw,6.2rem);line-height:.98}
.grad,.gold-text{background-image:linear-gradient(110deg,#C5A45A,#BFC3C7,#C5A45A);background-size:200% 100%;animation:shift 7s linear infinite}@keyframes shift{to{background-position:-200% 0}}
.hero-art,.experience-card,.journal-feature{background:linear-gradient(135deg,#151515,#202020)}
.hero-art{border-radius:32px;box-shadow:0 0 0 1px rgba(255,255,255,.04),0 30px 90px rgba(191,195,199,.3)}
.chips{position:absolute;top:18px;left:18px;right:18px;display:flex;gap:8px;flex-wrap:wrap;z-index:2}.chips span{padding:6px 13px;border-radius:99px;border:1px solid var(--line);background:rgba(5,6,10,.5);backdrop-filter:blur(10px);font:600 .72rem var(--head);letter-spacing:.08em}
.hero-stamp{z-index:2}
.experience-grid{grid-template-columns:1.25fr 1fr;grid-template-rows:repeat(2,minmax(240px,auto))}.experience-card:first-child{grid-row:span 2;min-height:520px}.experience-card{min-height:250px;border-radius:26px}
@media(max-width:900px){.experience-grid{grid-template-columns:1fr}.experience-card:first-child{grid-row:auto;min-height:380px}}
.bento{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:minmax(190px,auto);gap:16px}
.b{position:relative;overflow:hidden;padding:24px;border-radius:26px;border:1px solid var(--line);background:linear-gradient(160deg,rgba(255,255,255,.06),rgba(255,255,255,.015));display:flex;flex-direction:column;justify-content:flex-end;transition:.3s}
.b:hover{border-color:var(--c1);transform:translateY(-4px)}.b small{position:absolute;top:20px;left:24px;font:600 .72rem var(--head);letter-spacing:.2em;color:var(--c1)}.b h3{font-size:1.5rem;margin-bottom:4px;position:relative}.b p{margin:0;font-size:.92rem;position:relative;max-width:34ch}
.b-lg{grid-column:span 2;grid-row:span 2}.b-lg h3{font-size:2.4rem}.b-wide{grid-column:span 2}
.b-cta{background:var(--grad);border:0}.b-cta h3,.b-cta p,.b-cta span{color:#090909}.b-cta span{margin-top:14px;font-weight:700}
.wv{position:absolute;left:0;right:0;top:0;width:100%;height:55%;fill:url(#none);opacity:.5;color:var(--c1)}.wv use{fill:var(--c1)}.b-wide .wv{height:70%;opacity:.28}.b-lg .wv{height:60%}
@media(max-width:900px){.bento{grid-template-columns:1fr 1fr}.b-lg{grid-column:span 2}}@media(max-width:520px){.bento{grid-template-columns:1fr}.b-lg,.b-wide{grid-column:auto}.b-lg{grid-row:auto;min-height:300px}}
.cards>*,.service-card,.team-card,.step,.panel{background-image:radial-gradient(380px circle at var(--mx,50%) var(--my,-20%),rgba(197,164,90,.11),transparent 45%)}
.cards img{display:block!important;visibility:visible!important;opacity:1!important;width:100%!important;height:auto;aspect-ratio:1/1;object-fit:cover;background:linear-gradient(135deg,#151515,#202020)}
.cards [class*="cover"],.cards [class*="art"],.cards [class*="thumb"],.cards [class*="photo"],.cards [class*="image"]{min-height:160px;border-radius:12px;background-color:#101626;background-size:cover;background-position:center}
