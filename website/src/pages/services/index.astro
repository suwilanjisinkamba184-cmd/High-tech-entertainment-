---
import SiteLayout from '../../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const services = [
  {title:'Music production & recording',description:'Creative music production, beat-making and recording support for artists in Kitwe and across Zambia.',href:'music-production/',tag:'MUSIC & RECORDING'},
  {title:'Mixing & mastering',description:'A focused audio finishing process for balanced, clear and release-ready music.',href:'mixing-mastering/',tag:'AUDIO ENGINEERING'},
  {title:'Artist development & promotion',description:'Practical creative support to present music professionally and help artists reach listeners.',href:'artist-promotion/',tag:'ARTIST SERVICES'},
  {title:'Software & digital experiences',description:'Websites, digital products and software development for creative and business projects.',href:'software-development/',tag:'DIGITAL DEVELOPMENT'}
];
const canonical='https://suwilanjisinkamba184-cmd.github.io/High-tech-entertainment-/services/';
---
<SiteLayout title="Music Production & Creative Services in Zambia | HTE" description="Explore High-Tech Entertainment services in Kitwe, Zambia: music production, recording, mixing, mastering, artist promotion and software development." canonical={canonical}>
  <main class="services">
    <header><a href={base}>← HTE Universe</a><span>HIGH-TECH ENTERTAINMENT · KITWE, ZAMBIA</span></header>
    <section class="hero"><p>CREATIVE SERVICES</p><h1>Sound, stories and digital experiences.</h1><p>High-Tech Entertainment brings music production, audio engineering, artist support and software development together under one creative platform.</p></section>
    <section class="grid">{services.map((service,i)=><a class="card" href={base+'services/'+service.href}><span>{String(i+1).padStart(2,'0')} · {service.tag}</span><h2>{service.title}</h2><p>{service.description}</p><b>Explore service ↗</b></a>)}</section>
    <section class="cta"><h2>Have a project in mind?</h2><p>Tell us what you need and the team will help identify the next step.</p><a href={base+'#booking'}>Send a booking enquiry ↗</a></section>
    <footer><a href={base+'privacy-policy.html'}>Privacy</a><a href={base+'terms-of-service.html'}>Terms</a></footer>
  </main>
</SiteLayout>
<style>
.services{min-height:100vh;background:#090909;color:#f7f5ef;padding:0 clamp(20px,7vw,100px);font-family:Inter,system-ui,sans-serif}.services header{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #c5a45a35;color:#c5a45a;font-size:.76rem}.services header span{color:#85827b;font-size:.65rem;letter-spacing:.14em}.hero{padding:90px 0 55px;max-width:850px}.hero>p:first-child{color:#c5a45a;font-size:.7rem;font-weight:800;letter-spacing:.2em}.hero h1{font-size:clamp(2.8rem,7vw,6rem);line-height:.98;letter-spacing:-.06em;margin:20px 0}.hero>p:last-child,.card p,.cta p{color:#aaa79f;line-height:1.8}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.card{display:block;padding:30px;border:1px solid #ffffff1a;background:linear-gradient(140deg,#191a1b,#101010);transition:border-color .2s,transform .2s}.card:hover{border-color:#c5a45a;transform:translateY(-3px)}.card span{color:#c5a45a;font-size:.65rem;letter-spacing:.12em}.card h2{font-size:clamp(1.35rem,2.8vw,2rem);margin:20px 0 12px}.card b{display:inline-block;margin-top:14px;color:#d5b46b;font-size:.78rem}.cta{margin:70px 0;padding:40px;border:1px solid #c5a45a55;background:#171512}.cta h2{font-size:2rem}.cta a{display:inline-block;margin-top:12px;color:#d5b46b;font-weight:800}footer{display:flex;gap:20px;padding:25px 0;color:#999;font-size:.75rem}@media(max-width:650px){.grid{grid-template-columns:1fr}.services header{align-items:flex-start;flex-direction:column;justify-content:center;gap:5px}.hero{padding-top:65px}}
</style>
